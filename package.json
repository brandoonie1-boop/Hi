{
  "name": "brown-line-site",
  "version": "1.0.0",
  "private": true,
  "description": "Booking, payments and dispatch site for Brown Line IL LLC: server-rendered HTML on Node.js, Supabase and Stripe",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "css": "tailwindcss -i ./styles/input.css -o ./public/styles.css --minify"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
