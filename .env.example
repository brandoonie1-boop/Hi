# Copy this file to .env for running on your computer, and add the same
# variables in your host's dashboard (Render, Railway, ...) for the live site.
# Never commit real keys.

# Public address of the site, no trailing slash. On Render or Railway you can
# leave this out until the site has its own domain (they provide the address).
SITE_URL=http://localhost:3000
PORT=3000

# Supabase -> Project Settings -> API Keys
# (older projects: the "anon" and "service_role" keys work in these two slots)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe -> Developers -> API keys. Use the test keys until launch day.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
# (for local testing, the "stripe listen" command prints one)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: shown in the header and footer when set.
BUSINESS_PHONE=
BUSINESS_EMAIL=

# How many proxies sit in front of the site, used to tell visitors apart for
# the sign-in limits. The default is 1, right for one proxy such as Caddy.
# Render needs 3 (render.yaml sets it). Set 0 if nothing is in front of the
# site, and add 1 if you put your own proxy (like Cloudflare) in front of
# your host.
TRUSTED_PROXY_HOPS=
